{
  "rules": {
    "rooms": {
      "$game": {
        "$code": {
          ".read": true,
          ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
          "host": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
          },
          "created": {
            ".write": "auth != null && root.child('rooms').child($game).child($code).child('host').val() === auth.uid"
          },
          "online": {
            ".write": "auth != null && root.child('rooms').child($game).child($code).child('host').val() === auth.uid"
          },
          "state": {
            ".write": "auth != null && root.child('rooms').child($game).child($code).child('host').val() === auth.uid"
          },
          "viewers": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}
