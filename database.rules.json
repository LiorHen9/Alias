{
  "rules": {
    "rooms": {
      "$game": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
          "host": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
          },
          "created": {
            ".write": "auth != null && root.child('rooms').child($game).child($code).child('host').val() === auth.uid"
          },
          "members": {
            "$uid": {
              ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($game).child($code).child('host').val() === auth.uid)"
            }
          },
          "game": {
            ".write": "auth != null && (root.child('rooms').child($game).child($code).child('host').val() === auth.uid || root.child('rooms').child($game).child($code).child('members').child(auth.uid).exists())"
          },
          "turn": {
            ".write": "auth != null && root.child('rooms').child($game).child($code).child('members').child(auth.uid).exists()"
          }
        }
      }
    }
  }
}
